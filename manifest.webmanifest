{
  "name": "Instant Radio",
  "short_name": "Instant Radio",
  "id": "./",
  "description": "Paste text, press play, and turn information into a personal radio queue using browser text-to-speech.",
  "start_url": "./app/",
  "scope": "./app/",
  "display": "standalone",
  "background_color": "#f4f1e8",
  "theme_color": "#f4f1e8",
  "icons": [
    {
      "src": "./icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "./app/",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
